+    """Strictly parse a {filename: 0|1} mapping; raises ContractError on violation."""
+    try:
+        text = Path(path).read_text(encoding="utf-8")
+    except OSError as exc:
+        raise ContractError(f"cannot read file: {exc}") from exc
+    except UnicodeDecodeError as exc:
+        raise ContractError(f"file is not valid UTF-8: {exc}") from exc
+    try:
+        data = json.loads(text, object_pairs_hook=_object_pairs,
+                          parse_constant=_reject_constant)
+    except ContractError:
+        raise
+    except ValueError as exc:
+        raise ContractError(f"invalid JSON: {exc}") from exc
+    if not isinstance(data, dict):
+        raise ContractError("top-level JSON must be an object of filename -> 0|1")
+    problems = []
+    out = {}
+    for key, value in data.items():
+        problem = value_problem(value)
+        if problem is not None:
+            problems.append((key, problem))
+            continue
+        out[key] = int(value)
+    if problems:
+        shown = "; ".join(f"{key!r}: {reason}" for key, reason in problems[:10])
+        more = "" if len(problems) <= 10 else f" (+{len(problems) - 10} more)"
+        raise ContractError(f"{len(problems)} illegal label value(s): {shown}{more}")
+    return out
+
+
+def contract_problems(gt: dict, pred: dict) -> list[dict]:
+    """Coverage-level violations (missing / extra) between GT universe and predictions."""
+    problems = []
+    missing = sorted(set(gt) - set(pred))
+    extra = sorted(set(pred) - set(gt))
+    if missing:
+        problems.append({
+            "code": "missing_predictions_fail_closed",
+            "count": len(missing),
+            "names": missing[:20],
+            "message": "missing predictions are fatal under full-universe caliber",
+        })
+    if extra:
+        problems.append({
+            "code": "extra_predictions_fail_closed",
+            "count": len(extra),
+            "names": extra[:20],
+            "message": "predictions outside ground truth are fatal",
+        })
+    return problems
+
+
+def evaluate(gt: dict, pred: dict) -> dict:
+    """Official full-universe caliber over complete input dictionaries.
+
+    Missing predictions stay visible twice: as a fatal flag (contract) and in
+    the strict diagnostic column where each missing sample counts as its GT
+    label being missed (missing positives -> FN-equivalent recall shrinkage).
+    """
+    tp = fp = fn = tn = miss_pos = miss_neg = 0
+    for name, label in gt.items():
+        p = pred.get(name)
+        if p is None:
+            miss_pos += label == 1
+            miss_neg += label == 0
+            continue
+        if label == 1 and p == 1:
+            tp += 1
+        elif label == 1 and p == 0:
+            fn += 1
+        elif label == 0 and p == 1:
+            fp += 1
+        else:
+            tn += 1
+
+    precision_den = tp + fp
+    recall_den_strict = tp + fn + miss_pos   # every GT positive must appear here
+    recall_den_inter = tp + fn               # legacy intersection view (UNSAFE)
+
+    def ratio(num: int, den: int):
+        return num / den if den else None
+
+    precision = ratio(tp, precision_den)
+    recall = ratio(tp, recall_den_strict)
+    f1_diagnostic = (
+        2 * precision * recall / (precision + recall)
+        if precision is not None and recall is not None and (precision + recall) > 0
+        else None
+    )
+
+    return {
+        "tp": tp, "fp": fp, "fn": fn, "tn": tn,
+        "precision": precision,
+        "recall": recall,
+        "f1_diagnostic": f1_diagnostic,
+        "precision_denominator": precision_den,
+        "recall_denominator_strict": recall_den_strict,
+        "recall_denominator_intersection_UNSAFE": recall_den_inter,
+        "missing_count": miss_pos + miss_neg,
+        "missing_true_positive": miss_pos,
+        "missing_true_negative": miss_neg,
+        "intersection_basis_UNSAFE_DO_NOT_REPORT": {
+            "note": "legacy denominator set(gt)&set(pred); kept only to expose the trap",
+            "recall": ratio(tp, recall_den_inter),
+            "recall_inflation_trap_delta": (
+                ratio(tp, recall_den_inter) - recall
+                if recall_den_inter and recall is not None else None),
+        },
+        "undefined_flags": [flag for flag, v in
+                            (("precision", precision), ("recall", recall)) if v is None],
+        "complete_coverage": (miss_pos + miss_neg == 0),
+    }
 
 
