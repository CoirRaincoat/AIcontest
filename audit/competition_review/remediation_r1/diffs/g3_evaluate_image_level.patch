 import argparse
 import json
+import math
+import sys
 from pathlib import Path
 
+VALID_LABELS = {0, 1}
+EXIT_CONTRACT_VIOLATION = 2
+
+
+class ContractError(ValueError):
+    """Raised when an evaluation input violates the submission contract."""
+
+
+def _reject_constant(token: str):
+    raise ContractError(f"non-standard JSON constant not allowed: {token}")
+
+
+def _object_pairs(pairs):
+    keys = [k for k, _ in pairs]
+    dups = sorted({k for k in keys if keys.count(k) > 1})
+    if dups:
+        raise ContractError(f"duplicate JSON key(s): {dups}")
+    return dict(pairs)
+
+
+def value_problem(value) -> str | None:
+    """Return None for a legal 0/1 label, else a short machine-readable reason."""
+    if isinstance(value, bool):
+        return "boolean_not_int"
+    if isinstance(value, int):
+        return None if value in VALID_LABELS else "value_out_of_range"
+    if isinstance(value, float):
+        if math.isnan(value) or math.isinf(value):
+            return "nan_or_inf_value"
+        return "float_not_int"
+    if isinstance(value, str):
+        return "string_value"
+    if value is None:
+        return "null_value"
+    return "unsupported_type"
+
 
 def load_binary_json(path: str) -> dict:
